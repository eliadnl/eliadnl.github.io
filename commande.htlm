<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Page de commande</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      margin: 0;
      padding: 20px;
    }

    .container {
      max-width: 700px;
      margin: auto;
      background: white;
      padding: 20px;
      border-radius: 10px;
    }

    h1 {
      text-align: center;
    }

    label {
      display: block;
      margin-top: 10px;
      font-weight: bold;
    }

    input, textarea {
      width: 100%;
      padding: 8px;
      margin-top: 5px;
      border-radius: 5px;
      border: 1px solid #ccc;
    }

    .product {
      display: flex;
      justify-content: space-between;
      margin-top: 10px;
      align-items: center;
    }

    .product input {
      width: 80px;
    }

    button {
      width: 100%;
      margin-top: 20px;
      padding: 10px;
      background: black;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    .result {
      margin-top: 20px;
      padding: 10px;
      background: #eee;
      border-radius: 5px;
    }
  </style>
</head>

<body>

<div class="container">
  <h1>Commande</h1>

  <!-- INFOS CLIENT -->
  <label>Nom</label>
  <input type="text" id="nom">

  <label>Prénom</label>
  <input type="text" id="prenom">

  <label>Adresse de livraison</label>
  <input type="text" id="adresse">

  <label>Email</label>
  <input type="email" id="email">

  <label>Téléphone</label>
  <input type="text" id="telephone">

  <label>Message (optionnel)</label>
  <textarea id="message"></textarea>

  <hr>

  <!-- PRODUITS -->
  <div class="product">
    <span>Carte (3€ / 10g)</span>
    <input type="number" id="cartes" min="0" value="0">
  </div>

  <div class="product">
    <span>Sticker (1€ / 5g)</span>
    <input type="number" id="stickers" min="0" value="0">
  </div>

  <button onclick="calculer()">Calculer la commande</button>

  <div class="result" id="result"></div>
</div>

<script>
function calculer() {
  const cartes = parseInt(document.getElementById("cartes").value) || 0;
  const stickers = parseInt(document.getElementById("stickers").value) || 0;

  // Prix
  const prixCartes = cartes * 3;
  const prixStickers = stickers * 1;
  const totalProduits = prixCartes + prixStickers;

  // Poids
  const poids = (cartes * 10) + (stickers * 5);

  // Frais de port
  let livraison = 0;

  if (poids <= 20) livraison = 1.55;
  else if (poids <= 100) livraison = 3.10;
  else if (poids <= 250) livraison = 5.25;
  else if (poids <= 500) livraison = 7.45;
  else if (poids <= 1000) livraison = 9.30;
  else if (poids <= 2000) livraison = 11.15;
  else livraison = "Commande trop lourde";

  const total = (typeof livraison === "number")
    ? totalProduits + livraison
    : "N/A";

  document.getElementById("result").innerHTML = `
    <strong>Résumé de commande :</strong><br><br>
    Produits : ${totalProduits.toFixed(2)} €<br>
    Poids total : ${poids} g<br>
    Livraison : ${livraison} €<br>
    <hr>
    <strong>Total : ${total === "N/A" ? total : total.toFixed(2) + " €"}</strong>
  `;
}
</script>

</body>
</html>
